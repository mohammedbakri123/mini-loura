# HTTP server
PORT=3000

# PostgreSQL connection string (docker compose up starts a matching database)
DATABASE_URL=postgres://mini_loura:mini_loura@localhost:5432/mini_loura

# Optional: real LLM reasoning provider.
# When LLM_API_KEY is empty, the system uses FakeReasoningModel (no network calls).
LLM_API_KEY=
LLM_MODEL=
