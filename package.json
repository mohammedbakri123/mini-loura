{
  "name": "mini-loura",
  "version": "0.1.0",
  "description": "Governed agentic operational system prototype (Sense -> Understand -> Decide -> Govern -> Act -> Verify -> Audit)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"tsx watch src/server.ts\" \"npm run dev --prefix web\"",
    "build": "tsc && npm run build --prefix web",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && npm run typecheck --prefix web",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "dotenv": "^17.2.1",
    "fastify": "^5.3.1",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "concurrently": "^10.0.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
